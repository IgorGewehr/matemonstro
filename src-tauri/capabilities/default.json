{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Janela principal: fs restrito ao vault (Documents/Matemonstro), dialog para trocar a pasta do vault (pasta escolhida estende o scope automaticamente), store para config fora do webview.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "store:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DOCUMENT/Matemonstro" },
        { "path": "$DOCUMENT/Matemonstro/**" }
      ]
    }
  ]
}
